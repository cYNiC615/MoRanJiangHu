# Copy to .env.production for local production builds.
# Do not commit .env.production. Values with VITE_ are embedded into frontend assets.

# Legacy compatibility only. Most model/API settings are configured in the app UI.
GEMINI_API_KEY=

# ComfyUI backend discovery/runtime vars, if you build the worker locally.
CNB_SYNC_TOKEN=
CNB_SYNC_FORWARD_URL=
CNB_SYNC_FORWARD_TOKEN=
CNB_SYNC_ALLOW_ANY_URL=false
CNB_SYNC_R2_KEY=moranjianghu/cnb-sync-registry.json
CNB_SYNC_REGISTRY_TTL_SEC=900
